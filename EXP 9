#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

struct Instruction {
    char left;
    char right[20];
};

void constantFolding(char *expr) {
    int a, b;
    char op;
    if (sscanf(expr, "%d%c%d", &a, &op, &b) == 3) {
        int res = (op == '+') ? a + b : 
                  (op == '-') ? a - b : 
                  (op == '*') ? a * b : 
                  (op == '/') ? a / b : 0;
        sprintf(expr, "%d", res);
        printf("[Constant Folding Applied] Computed constant result.\n");
    }
}

void strengthReduction(char *expr) {
    char var[10];
    int num;
    if (sscanf(expr, "%[a-zA-Z]*%d", var, &num) == 2) {
        if (num == 2) {
            sprintf(expr, "%s<<1", var);
            printf("[Strength Reduction Applied] Replaced multiplication by 2 with bitwise left shift.\n");
        } else if (num == 0) {
            strcpy(expr, "0");
            printf("[Strength Reduction Applied] Replaced multiplication by 0 with 0.\n");
        }
    }
}

void algebraicTransformation(char *expr) {
    if (strcmp(expr, "x+0") == 0 || strcmp(expr, "0+x") == 0) {
        strcpy(expr, "x");
        printf("[Algebraic Transformation Applied] Removed identity addition (+0).\n");
    } else if (strcmp(expr, "x*1") == 0 || strcmp(expr, "1*x") == 0) {
        strcpy(expr, "x");
        printf("[Algebraic Transformation Applied] Removed identity multiplication (*1).\n");
    }
}

int main() {
    int n;
    struct Instruction code[10];

    printf("--- CODE OPTIMIZATION LABORATORY ---\n\n");
    printf("Enter number of intermediate instructions: ");
    if (scanf("%d", &n) != 1) return 0;

    for (int i = 0; i < n; i++) {
        printf("\nInstruction %d:\n", i + 1);
        printf("Left operand (Variable): ");
        scanf(" %c", &code[i].left);
        printf("Right expression (e.g., 3+5, x*2, x+0): ");
        scanf("%s", code[i].right);
    }

    printf("\n--- Original Intermediate Code ---\n");
    for (int i = 0; i < n; i++) {
        printf("%c = %s\n", code[i].left, code[i].right);
    }

    printf("\n--- Applying Optimization Techniques ---\n");
    for (int i = 0; i < n; i++) {
        printf("\nOptimizing Statement %d: %c = %s\n", i + 1, code[i].left, code[i].right);
        constantFolding(code[i].right);
        strengthReduction(code[i].right);
        algebraicTransformation(code[i].right);
    }

    printf("\n=== FINAL OPTIMIZED CODE ===\n");
    for (int i = 0; i < n; i++) {
        printf("%c = %s\n", code[i].left, code[i].right);
    }

    printf("\n--- Loop Optimization Concept (Factorial Execution) ---\n");
    int num = 5, k = 1;
    long long fact_for = 1, fact_dowhile = 1;

    for (int j = 1; j <= num; j++) {
        fact_for *= j;
    }

    do {
        fact_dowhile *= k;
        k++;
    } while (k <= num);

    printf("Factorial of %d using 'for' loop: %lld\n", num, fact_for);
    printf("Factorial of %d using 'do-while' loop: %lld\n", num, fact_dowhile);
    printf("Note: Do-While skips initial check overhead before entering body.\n");

    return 0;
}

