#include <stdio.h>
#include <stdlib.h>

char input[100];
int pos = 0;

void E();
void EP();
void T();
void TP();
void F();

void error() {
    printf("\nString Rejected\n");
    exit(0);
}

void match(char c) {
    if (input[pos] == c)
        pos++;
    else
        error();
}

void E() {
    T();
    EP();
}

void EP() {
    if (input[pos] == '+') {
        match('+');
        T();
        EP();
    }
}

void T() {
    F();
    TP();
}

void TP() {
    if (input[pos] == '*') {
        match('*');
        F();
        TP();
    }
}

void F() {
    if (input[pos] == 'i') {
        match('i');
    } else if (input[pos] == '(') {
        match('(');
        E();
        match(')');
    } else {
        error();
    }
}

int main() {
    printf("Enter expression: ");
    scanf("%s", input);

    E();

    if (input[pos] == '\0')
        printf("\nString Accepted\n");
    else
        printf("\nString Rejected\n");

    return 0;
}
