cat << 'EOF' > exp6.y
%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token INTEGER FLOAT CHAR EOL

%%

statement_list:
    /* empty */
    | statement_list stmt
    ;

stmt:
    expression EOL
        {
            if ($1 == INTEGER)
                printf("Type: INTEGER\n");
            else if ($1 == FLOAT)
                printf("Type: FLOAT\n");
            else if ($1 == CHAR)
                printf("Type: CHAR/STRING\n");
            else
                printf("Invalid type\n");
        }
    ;

expression:
    INTEGER       { $$ = INTEGER; }
    | FLOAT       { $$ = FLOAT; }
    | CHAR        { $$ = CHAR; }
    ;

%%

void yyerror(const char *s)
{
    printf("Invalid type or Parse error\n");
}

int main()
{
    yyparse();
    return 0;
}
EOF

