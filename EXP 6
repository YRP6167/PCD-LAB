%%

[0-9]+\.[0-9]+   { return FLOAT; }
[0-9]+           { yylval = atoi(yytext); return INTEGER; }
[a-zA-Z]+        { return CHAR; }
[\n]             { return EOL; }
.                { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}
