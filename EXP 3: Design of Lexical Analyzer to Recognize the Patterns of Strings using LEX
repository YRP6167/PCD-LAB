Aim: To design and implement a lexical analyzer using LEX (Flex) for recognizing keywords, identifiers, and integer constants.
VSCODE + Ubuntu(Powershell)-- wsl -d ubuntu
for command sachin bhopi github

exp3.l(code)

%{
#include <stdio.h>
%}

%%

int|float|char {
    printf("Keyword : %s\n", yytext);
}

[a-zA-Z_][a-zA-Z0-9_]* {
    printf("Identifier : %s\n", yytext);
}

[0-9]+ {
    printf("Integer : %s\n", yytext);
}

[ \t\n]+ {
    /* ignore whitespace */
}

. {
    printf("Unknown Token : %s\n", yytext);
}

%%

int main() {
    printf("Enter Source Code:\n\n");
    yylex();
    return 0;
}

int yywrap() {
    return 1;
}
