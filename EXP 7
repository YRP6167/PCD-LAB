exp7.y

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void yyerror(const char *s);
int yylex(void);

int temp_count = 1;

char* create_temp() {
    char *temp = (char*)malloc(10);
    sprintf(temp, "t%d", temp_count++);
    return temp;
}
%}

%union {
    char *str;
    int num;
}

%token <num> NUM
%type <str> E

%left '+' '-'
%left '*' '/'

%%

S : E {
    printf("Result: %s\n", $1);
}
;

E : E '+' E {
        $$ = create_temp();
        printf("%s = %s + %s\n", $$, $1, $3);
    }
  | E '-' E {
        $$ = create_temp();
        printf("%s = %s - %s\n", $$, $1, $3);
    }
  | E '*' E {
        $$ = create_temp();
        printf("%s = %s * %s\n", $$, $1, $3);
    }
  | E '/' E {
        $$ = create_temp();
        printf("%s = %s / %s\n", $$, $1, $3);
    }
  | '(' E ')' {
        $$ = $2;
    }
  | NUM {
        char *buffer = (char*)malloc(10);
        sprintf(buffer, "%d", $1);
        $$ = buffer;
    }
;

%%

void yyerror(const char *s) {
    fprintf(stderr, "Error: %s\n", s);
}

int main(void) {
    printf("Enter an arithmetic expression:\n");
    yyparse();
    return 0;
}

